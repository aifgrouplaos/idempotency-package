{
  "name": "@bounkhong/idempotency-adapter-memory",
  "version": "0.1.0",
  "description": "In-memory idempotency store adapter for AIF core",
  "license": "MIT",
  "author": "Bounkhong (AIF)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aif/idempotency-package.git"
  },
  "bugs": {
    "url": "https://github.com/aif/idempotency-package/issues"
  },
  "homepage": "https://github.com/aif/idempotency-package#readme",
  "keywords": ["idempotency", "adapter", "memory", "nodejs"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bounkhong/idempotency-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
